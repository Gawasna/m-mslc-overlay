<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="m_mslc_overlay.views.dialogs.MessageDialog"
        Title="Thông báo"
        Icon="avares://m-mslc-overlay/assets/icons/app-icon.ico"
        Width="420"
        MinHeight="160"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BgWindowBrush}">
    <Grid RowDefinitions="*, Auto" Margin="20" MinHeight="100">
        <TextBlock x:Name="MessageText" Grid.Row="0" Text="Nội dung thông báo"
                   TextWrapping="Wrap" FontSize="13"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Stretch"
                   TextAlignment="Left" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="CancelBtn" Content="Hủy" MinWidth="88" Height="28" Padding="14,4"
                    HorizontalContentAlignment="Center" Click="CancelBtn_Click"
                    Classes="SecondaryBtn" IsVisible="False"/>
            <Button x:Name="OkBtn" Content="OK" MinWidth="88" Height="28" Padding="14,4"
                    HorizontalContentAlignment="Center" Click="OkBtn_Click" Classes="PrimaryBtn"/>
        </StackPanel>
    </Grid>
</Window>
