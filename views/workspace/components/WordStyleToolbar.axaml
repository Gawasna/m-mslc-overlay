<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMslcOverlay.ViewModels.Workspace"
             x:Class="MMslcOverlay.Views.Workspace.Components.WordStyleToolbar"
             x:DataType="vm:PaperSheetViewModel">

    <!--
        WordStyleToolbar: MS Word-style formatting bar.
        No fixed Height — let content define row height (avoids clipping).
        Colors use app's StaticResources to stay in the mono/orange schema.
    -->
    <Border Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4">

        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                <!-- Font family dropdown -->
                <ComboBox SelectedValue="{Binding GlobalFontFamily}"
                          Width="96" Height="24" FontSize="10"
                          CornerRadius="2"
                          ToolTip.Tip="Font Family">
                    <ComboBoxItem Content="Georgia"/>
                    <ComboBoxItem Content="Segoe UI"/>
                    <ComboBoxItem Content="Consolas"/>
                    <ComboBoxItem Content="Times New Roman"/>
                    <ComboBoxItem Content="Arial"/>
                    <ComboBoxItem Content="Lora"/>
                </ComboBox>

                <!-- Font size dropdown -->
                <NumericUpDown Value="{Binding GlobalFontSize}"
                               Minimum="6" Maximum="72" Increment="1"
                               Width="56" Height="24" FontSize="10"
                               CornerRadius="2" FormatString="F0"
                               ToolTip.Tip="Font Size" />

                <!-- Separator -->
                <Rectangle Width="1" Height="16" Fill="{StaticResource BorderLightBrush}" />

                <!-- B / I / U style toggles -->
                <ToggleButton IsChecked="{Binding GlobalBold}"
                              Width="24" Height="24" Padding="0" CornerRadius="2"
                              ToolTip.Tip="Bold">
                    <TextBlock Text="B" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>

                <ToggleButton IsChecked="{Binding GlobalItalic}"
                              Width="24" Height="24" Padding="0" CornerRadius="2"
                              ToolTip.Tip="Italic">
                    <TextBlock Text="I" FontStyle="Italic" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>

                <ToggleButton IsChecked="{Binding GlobalUnderline}"
                              Width="24" Height="24" Padding="0" CornerRadius="2"
                              ToolTip.Tip="Underline">
                    <TextBlock Text="U" TextDecorations="Underline" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </ToggleButton>

                <!-- Separator -->
                <Rectangle Width="1" Height="16" Fill="{StaticResource BorderLightBrush}" />

                <!-- Alignment buttons -->
                <Button Content="L" FontSize="11" Width="24" Height="24"
                        Padding="0" CornerRadius="2" Classes="ToolbarToggleBtn"
                        ToolTip.Tip="Align Left" />
                <Button Content="C" FontSize="11" Width="24" Height="24"
                        Padding="0" CornerRadius="2" Classes="ToolbarToggleBtn"
                        ToolTip.Tip="Align Center" />
                <Button Content="R" FontSize="11" Width="24" Height="24"
                        Padding="0" CornerRadius="2" Classes="ToolbarToggleBtn"
                        ToolTip.Tip="Align Right" />

                <!-- Separator -->
                <Rectangle Width="1" Height="16" Fill="{StaticResource BorderLightBrush}" />

                <!-- Edit Mode badge — uses app's Primary orange accent -->
                <Border CornerRadius="3" Background="{StaticResource PrimaryBrush}" Padding="10,3">
                    <TextBlock Text="Edit Mode" FontSize="10" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" />
                </Border>

                <!-- Review Mode badge -->
                <Border CornerRadius="3" Background="Transparent"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,3">
                    <TextBlock Text="Review" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
