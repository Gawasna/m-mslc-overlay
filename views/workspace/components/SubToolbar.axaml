<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMslcOverlay.ViewModels.Workspace"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MMslcOverlay.Views.Workspace.Components.SubToolbar"
             x:DataType="vm:WorkspaceViewModel">

    <!--
        SubToolbar: AI model picker, export/import, view toggles.
        Toggle pills implemented as ToggleButton (no native CheckBox) to avoid
        Fluent CheckBox icon leaking out of the compact pill layout.
    -->
    <Border Background="{StaticResource BgWindowBrush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,4">

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

            <!-- AI model selector -->
            <Border Width="140" Height="24" CornerRadius="3"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Background="{StaticResource BgCardBrush}" Padding="8,0">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectedAiModel, StringFormat='AI: {0}'}"
                               FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="▾"
                               FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Separator -->
            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderLightBrush}" />

            <!-- Record button — click gọi StartRecording/StopRecording -->
            <Button x:Name="RecordBtn"
                    Classes="SubToolbarPill"
                    ToolTip.Tip="Toggle audio recording (manual control)"
                    IsEnabled="{Binding IsOpen}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- Recording indicator: red pulsing dot when active -->
                    <Ellipse x:Name="RecordingIndicator"
                             Width="8" Height="8"
                             Fill="Red"
                             IsVisible="False">
                        <Ellipse.Styles>
                            <Style Selector="Ellipse">
                                <Style.Animations>
                                    <Animation Duration="0:0:1" IterationCount="Infinite">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="50%">
                                            <Setter Property="Opacity" Value="0.3"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Ellipse.Styles>
                    </Ellipse>
                    
                    <mi:MaterialIcon x:Name="RecordIcon" Kind="Microphone" Width="12" Height="12"
                                            Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="RecordLabel" FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" Text="Record" />
                </StackPanel>
            </Button>

            <!-- Separator -->
            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderLightBrush}" />

            <!-- Export SRT button -->
            <Button x:Name="ExportSrtBtn"
                    Content="Export .SRT"
                    FontSize="10" Padding="10,3" CornerRadius="3"
                    Background="{StaticResource BgCardBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Export transcript as SRT subtitle file" />

            <!-- Import Script button -->
            <Button x:Name="ImportScriptBtn"
                    Content="Import Script"
                    FontSize="10" Padding="10,3" CornerRadius="3"
                    Background="{StaticResource BgCardBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Import a reference script" />

            <!-- Separator -->
            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderLightBrush}" />

            <!-- Auto-Scroll pill toggle -->
            <ToggleButton x:Name="AutoScrollToggle"
                          IsChecked="{Binding Sheet.AutoScroll}"
                          Classes="SubToolbarPill"
                          ToolTip.Tip="Toggle automatic scrolling to latest segment">
                <TextBlock Text="Auto-Scroll" FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </ToggleButton>

            <!-- Focus Mode pill toggle -->
            <ToggleButton x:Name="FocusModeToggle"
                          IsChecked="{Binding Sheet.FocusMode}"
                          Classes="SubToolbarPill"
                          ToolTip.Tip="Toggle focus mode (hides navigation pane)">
                <TextBlock Text="Focus Mode" FontSize="10"
                           VerticalAlignment="Center" />
                </ToggleButton>

        </StackPanel>
    </Border>
</UserControl>
