<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMslcOverlay.ViewModels.Workspace"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MMslcOverlay.Views.Workspace.Components.DocumentNavigationPane"
             x:DataType="vm:NavPaneViewModel"
             Classes.compact="{Binding IsCompact}">

    <UserControl.Styles>
        <Style Selector="UserControl">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="MaxWidth" Value="400" />
        </Style>
        <Style Selector="UserControl.compact">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MaxWidth" Value="42" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- EXPANDED MODE -->
        <Grid RowDefinitions="Auto, *" IsVisible="{Binding !IsCompact}">
            <!-- ─── Pane Header ─────────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgWindowBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,1"
                    Height="32"
                    Padding="8,0">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- State switcher: icon-style tabs -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        
                        <Button x:Name="BtnSpeaker"
                                Width="24" Height="24" Padding="0" CornerRadius="3"
                                ToolTip.Tip="Speaker Annotation"
                                Classes="NavTabBtn"
                                Classes.active="{Binding ShowSpeakerAnnotation}">
                            <mi:MaterialIcon Kind="AccountVoice" Width="16" Height="16" />
                        </Button>
                        
                        <Button x:Name="BtnFindReplace"
                                Width="24" Height="24" Padding="0" CornerRadius="3"
                                ToolTip.Tip="Find &amp; Replace"
                                Classes="NavTabBtn"
                                Classes.active="{Binding ShowFindReplace}">
                            <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" />
                        </Button>
                        
                        <Button x:Name="BtnSummary"
                                Width="24" Height="24" Padding="0" CornerRadius="3"
                                ToolTip.Tip="AI Summary"
                                Classes="NavTabBtn"
                                Classes.active="{Binding ShowAiSummary}">
                            <mi:MaterialIcon Kind="AutoAwesome" Width="16" Height="16" />
                        </Button>
                        
                        <Button x:Name="BtnAutoCorrect"
                                Width="24" Height="24" Padding="0" CornerRadius="3"
                                ToolTip.Tip="AI Auto-Correct"
                                Classes="NavTabBtn"
                                Classes.active="{Binding ShowAiAutoCorrect}">
                            <mi:MaterialIcon Kind="Spellcheck" Width="16" Height="16" />
                        </Button>
                        
                        <Button x:Name="BtnGlossary"
                                Width="24" Height="24" Padding="0" CornerRadius="3"
                                ToolTip.Tip="Glossary"
                                Classes="NavTabBtn"
                                Classes.active="{Binding ShowGlossary}">
                            <mi:MaterialIcon Kind="BookAlphabet" Width="16" Height="16" />
                        </Button>
                    </StackPanel>

                    <!-- Compact toggle & close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="BtnToggleCompact"
                                ToolTip.Tip="Collapse Pane"
                                Width="24" Height="24"
                                Padding="0" CornerRadius="2"
                                Classes="NavTabBtn">
                            <mi:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" />
                        </Button>
                        
                        <Button x:Name="BtnClose"
                                ToolTip.Tip="Close Pane"
                                Width="24" Height="24"
                                Padding="0" CornerRadius="2"
                                Classes="NavTabBtn">
                            <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        <!-- ─── State Panels ────────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Panel>

                <!-- == STATE 1: Speaker Annotation ============================================ -->
                <Grid IsVisible="{Binding ShowSpeakerAnnotation}" RowDefinitions="Auto, *, Auto">

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BgWindowBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Speaker Annotation"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <!-- Refresh suggestions button -->
                            <Button Grid.Column="1" x:Name="RefreshSuggestionsBtn"
                                    Width="22" Height="22" Padding="0" CornerRadius="3"
                                    ToolTip.Tip="Refresh merge suggestions"
                                    Classes="NavTabBtn"
                                    IsVisible="{Binding IsDiarizerAvailable}">
                                <mi:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable speaker list + suggestions -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="0">

                            <!-- P3.5: Fallback panel when diarizer unavailable -->
                            <StackPanel IsVisible="{Binding !IsDiarizerAvailable}" Margin="10,12" Spacing="6">
                                <TextBlock Text="Speaker Diarization không khả dụng."
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding DiarizerUnavailableReason}"
                                           MaxWidth="{Binding Bounds.Width, ElementName=OpenPreferencesBtn}"
                                           FontSize="10" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                <Button x:Name="OpenPreferencesBtn"
                                        Content="Mở Preferences để cài đặt"
                                        Click="OpenPreferencesBtn_Click"
                                        Classes="LinkBtn" FontSize="11"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Speaker list (visible when diarizer available) -->
                            <ItemsControl x:Name="SpeakerList"
                                          ItemsSource="{Binding Speakers}"
                                          IsVisible="{Binding IsDiarizerAvailable}"
                                          Padding="0">
                                <ItemsControl.DataTemplates>
                                    <DataTemplate x:DataType="vm:SpeakerAnnotation">
                                        <Border BorderBrush="{StaticResource BgWindowBrush}"
                                                BorderThickness="0,0,0,1" Padding="10,6">
                                            <Grid ColumnDefinitions="Auto, *, Auto">

                                                <!-- Color dot -->
                                                <Ellipse Grid.Column="0"
                                                         Width="8" Height="8"
                                                         Fill="{Binding ColorHex}"
                                                         VerticalAlignment="Top"
                                                         Margin="0,4,8,0" />

                                                <!-- Name + segments -->
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBox x:Name="NameEditor"
                                                             Text="{Binding DisplayName, Mode=TwoWay}"
                                                             FontSize="11"
                                                             FontWeight="Medium"
                                                             Padding="0"
                                                             MinHeight="0"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="{StaticResource TextPrimaryBrush}"
                                                             VerticalAlignment="Center"
                                                             ToolTip.Tip="Click to edit speaker name" />

                                                    <TextBlock Text="{Binding SegCountLabel}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               Margin="0,2,0,0"
                                                               IsVisible="{Binding HasSegments}" />
                                                </StackPanel>

                                                <!-- Merge button -->
                                                <Button Grid.Column="2"
                                                        x:Name="MergeSpeakerBtn"
                                                        Width="22" Height="22"
                                                        Padding="0" CornerRadius="3"
                                                        Classes="NavTabBtn"
                                                        VerticalAlignment="Top"
                                                        ToolTip.Tip="Merge into another speaker"
                                                        Tag="{Binding SpeakerKey}">
                                                    <mi:MaterialIcon Kind="MergeType" Width="14" Height="14" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>

                            <!-- Hint when empty and diarizer is running -->
                            <TextBlock Text="Speakers will appear here as segments arrive."
                                       IsVisible="{Binding IsDiarizerAvailable}"
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="10,8" />

                            <!-- ── Merge Suggestions section ────────────────────── -->
                            <StackPanel IsVisible="{Binding HasMergeSuggestions}" Spacing="0">
                                <Border Background="{StaticResource BgWindowBrush}"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="0,1,0,1" Padding="10,4">
                                    <TextBlock Text="Similar voices detected"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>

                                <ItemsControl x:Name="SuggestionList"
                                              ItemsSource="{Binding MergeSuggestions}">
                                    <ItemsControl.DataTemplates>
                                        <DataTemplate x:DataType="vm:MergeSuggestion">
                                            <Border BorderBrush="{StaticResource BorderLightBrush}"
                                                    BorderThickness="0,0,0,1" Padding="10,6">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button x:Name="AcceptSuggestionBtn"
                                                                Content="Merge"
                                                                FontSize="10" Padding="8,2"
                                                                Classes="PrimaryBtn" CornerRadius="3"
                                                                Tag="{Binding}" />
                                                        <Button x:Name="DismissSuggestionBtn"
                                                                Content="Dismiss"
                                                                FontSize="10" Padding="8,2"
                                                                Classes="SecondaryBtn" CornerRadius="3"
                                                                Tag="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.DataTemplates>
                                </ItemsControl>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Merge target picker popup (shown programmatically) -->
                    <Border Grid.Row="2" x:Name="MergePickerPanel" IsVisible="False"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="10,8">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="MergePickerTitle" Text="Merge into:"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <ItemsControl x:Name="MergeTargetList"
                                          ItemsSource="{Binding Speakers}">
                                <ItemsControl.DataTemplates>
                                    <DataTemplate x:DataType="vm:SpeakerAnnotation">
                                        <Button Content="{Binding DisplayName}"
                                                x:Name="MergeTargetBtn"
                                                FontSize="11" Padding="6,3"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Classes="NavTabBtn"
                                                Tag="{Binding SpeakerKey}" />
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                            <Button x:Name="CancelMergeBtn" Content="Cancel"
                                    FontSize="10" Padding="6,3"
                                    Classes="SecondaryBtn" CornerRadius="3" />
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- ══ STATE 2: Find & Replace ════════════════════════════════ -->
                <StackPanel IsVisible="{Binding ShowFindReplace}" Spacing="0">

                    <!-- Header -->
                    <Border Background="{StaticResource BgWindowBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="Find &amp; Replace"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>

                    <StackPanel Spacing="8" Margin="10">

                        <!-- Find field -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="Find" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="FindTextBox"
                                     Text="{Binding FindReplace.FindText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11" Height="28"
                                     Watermark="Search in transcript..." />
                        </StackPanel>

                        <!-- Replace field -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="Replace with" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="ReplaceTextBox"
                                     Text="{Binding FindReplace.ReplaceText}"
                                     FontSize="11" Height="28"
                                     Watermark="Replacement text..." />
                        </StackPanel>

                        <!-- Replace Scope field -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="Scope" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox x:Name="ScopeComboBox"
                                      SelectedIndex="{Binding FindReplace.ReplaceScope}"
                                      FontSize="11" Height="28" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="All Segments (Both)" />
                                <ComboBoxItem Content="Machine Segments Only" />
                                <ComboBoxItem Content="Human Segments Only" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Action buttons -->
                        <Grid ColumnDefinitions="*, 8, *">
                            <Button Grid.Column="0" x:Name="FindNextBtn"
                                    Content="Find Next"
                                    FontSize="10" Padding="0,5"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Classes="SecondaryBtn" CornerRadius="3" />
                            <Button Grid.Column="2" x:Name="ReplaceAllBtn"
                                    Content="Replace All"
                                    FontSize="10" Padding="0,5"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Classes="PrimaryBtn" CornerRadius="3" />
                        </Grid>

                        <!-- Result message -->
                        <TextBlock Text="{Binding FindReplace.ResultMessage}"
                                   FontSize="10" Foreground="{StaticResource PrimaryBrush}"
                                   IsVisible="{Binding FindReplace.HasSearched}" />

                    </StackPanel>
                </StackPanel>

                <!-- ══ STATE 3: AI Summary ════════════════════════════════════ -->
                <Grid IsVisible="{Binding ShowAiSummary}" RowDefinitions="Auto, *">

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource BgWindowBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="AI Summary"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="Gemini"
                                       FontSize="9" Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8" Margin="10">

                        <!-- Generate button -->
                        <Button x:Name="GenerateSummaryBtn"
                                Content="Generate Summary"
                                FontSize="10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,6"
                                Classes="PrimaryBtn" CornerRadius="3"
                                IsEnabled="{Binding !AiPane.IsBusy}" />

                        <!-- Configuration expander -->
                        <Expander x:Name="AiConfigExpander" Header="Configuration (Auto-Trigger)" FontSize="10" 
                                  Padding="5,0" Margin="0" MinHeight="24"
                                  BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" 
                                  Background="{StaticResource BgWindowBrush}" CornerRadius="3">
                            <StackPanel Spacing="6" Margin="0,5,0,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Gemini API Key" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding AiPane.GeminiApiKey}" PasswordChar="•" FontSize="10" Height="24" Watermark="Enter API key..." />
                                </StackPanel>

                                <TextBlock Text="Auto-trigger rule:" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                
                                <Grid ColumnDefinitions="Auto, *">
                                    <RadioButton Grid.Column="0" Content="By Segments" GroupName="TriggerMode" 
                                                 IsChecked="{Binding AiPane.IsModeSegments}" FontSize="10" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding AiPane.SummaryTriggerSegments}" 
                                                   Minimum="0" Maximum="1000" FormatString="0" 
                                                   IsEnabled="{Binding AiPane.IsModeSegments}"
                                                   Height="24" FontSize="10" Margin="10,0,0,0" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto, *">
                                    <RadioButton Grid.Column="0" Content="By Words" GroupName="TriggerMode" 
                                                 IsChecked="{Binding AiPane.IsModeWords}" FontSize="10" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding AiPane.SummaryTriggerWords}" 
                                                   Minimum="0" Maximum="10000" FormatString="0" 
                                                   IsEnabled="{Binding AiPane.IsModeWords}"
                                                   Height="24" FontSize="10" Margin="10,0,0,0" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto, *">
                                    <RadioButton Grid.Column="0" Content="By Time (s)" GroupName="TriggerMode" 
                                                 IsChecked="{Binding AiPane.IsModeTime}" FontSize="10" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding AiPane.SummaryTriggerTimeSeconds}" 
                                                   Minimum="0" Maximum="3600" FormatString="0" 
                                                   IsEnabled="{Binding AiPane.IsModeTime}"
                                                   Height="24" FontSize="10" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Busy indicator -->
                        <ProgressBar IsVisible="{Binding AiPane.IsBusy}"
                                     IsIndeterminate="True"
                                     Height="3" />

                        <!-- Summary output -->
                        <Border CornerRadius="3"
                                Background="{StaticResource BgWindowBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Padding="8,6"
                                MinHeight="120">
                            <TextBlock Text="{Binding AiPane.SummaryText}"
                                       MaxWidth="{Binding Bounds.Width, ElementName=AiConfigExpander}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       LineHeight="18" />
                        </Border>

                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══ STATE 4: AI Auto-Correct ═══════════════════════════════ -->
                <StackPanel IsVisible="{Binding ShowAiAutoCorrect}" Spacing="0">

                    <!-- Header -->
                    <Border Background="{StaticResource BgWindowBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="AI Auto-Correct"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>

                    <StackPanel Spacing="10" Margin="10">

                        <!-- Options -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Correction scope" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Spacing="4">
                                <CheckBox IsChecked="{Binding AiPane.FixSpelling}">
                                    <TextBlock Text="Fix spelling &amp; grammar" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding AiPane.ImproveStyle}">
                                    <TextBlock Text="Improve readability" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                </CheckBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Run button -->
                        <Button x:Name="RunCorrectBtn"
                                Content="Apply Corrections"
                                FontSize="10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,6"
                                Classes="PrimaryBtn" CornerRadius="3"
                                IsEnabled="{Binding !AiPane.IsBusy}" />

                        <!-- Busy indicator -->
                        <ProgressBar IsVisible="{Binding AiPane.IsBusy}"
                                     IsIndeterminate="True"
                                     Height="3" />

                        <!-- Result text -->
                        <TextBlock Text="{Binding AiPane.CorrectResultMessage}"
                                   MaxWidth="{Binding Bounds.Width, ElementName=RunCorrectBtn}"
                                   FontSize="10" Foreground="{StaticResource StatusActiveBrush}"
                                   TextWrapping="Wrap" />

                    </StackPanel>
                </StackPanel>

                <!-- ══ STATE 5: Glossary ══════════════════════════════════════ -->
                <Grid IsVisible="{Binding ShowGlossary}" RowDefinitions="Auto, *, Auto">

                    <!-- Header -->
                    <Border Grid.Row="0" x:Name="GlossaryHeader"
                            Background="{StaticResource BgWindowBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Glossary"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding GlossaryEntries.Count, StringFormat='{}{0} terms'}"
                                       FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Term list -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding GlossaryEntries}">
                            <ItemsControl.DataTemplates>
                                <DataTemplate x:DataType="vm:GlossaryEntry">
                                    <Border BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Term}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding Definition}"
                                                       MaxWidth="{Binding Bounds.Width, ElementName=GlossaryHeader}"
                                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add entry row -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BgWindowBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                            Padding="8">
                        <StackPanel Spacing="4">
                            <TextBox x:Name="GlossaryTermBox"
                                     Watermark="Term..." FontSize="10" Height="24" />
                            <TextBox x:Name="GlossaryDefBox"
                                     Watermark="Definition..." FontSize="10" Height="24" />
                            <Button x:Name="AddGlossaryEntryBtn"
                                    Content="Add Term"
                                    FontSize="10" Padding="0,4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Classes="SecondaryBtn" CornerRadius="3" />
                        </StackPanel>
                    </Border>
                </Grid>

            </Panel>
        </Border>

        </Grid>

        <!-- COMPACT MODE -->
        <Border IsVisible="{Binding IsCompact}"
                Background="{StaticResource BgWindowBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="0,8">
            <Grid RowDefinitions="*, Auto">
                <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">
                    <Button x:Name="BtnSpeakerCompact"
                            Width="28" Height="28" Padding="0" CornerRadius="3"
                            ToolTip.Tip="Speaker Annotation"
                            Classes="NavTabBtn"
                            Classes.active="{Binding ShowSpeakerAnnotation}">
                        <mi:MaterialIcon Kind="AccountVoice" Width="18" Height="18" />
                    </Button>
                    
                    <Button x:Name="BtnFindReplaceCompact"
                            Width="28" Height="28" Padding="0" CornerRadius="3"
                            ToolTip.Tip="Find &amp; Replace"
                            Classes="NavTabBtn"
                            Classes.active="{Binding ShowFindReplace}">
                        <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" />
                    </Button>
                    
                    <Button x:Name="BtnSummaryCompact"
                            Width="28" Height="28" Padding="0" CornerRadius="3"
                            ToolTip.Tip="AI Summary"
                            Classes="NavTabBtn"
                            Classes.active="{Binding ShowAiSummary}">
                        <mi:MaterialIcon Kind="AutoAwesome" Width="18" Height="18" />
                    </Button>
                    
                    <Button x:Name="BtnAutoCorrectCompact"
                            Width="28" Height="28" Padding="0" CornerRadius="3"
                            ToolTip.Tip="AI Auto-Correct"
                            Classes="NavTabBtn"
                            Classes.active="{Binding ShowAiAutoCorrect}">
                        <mi:MaterialIcon Kind="Spellcheck" Width="18" Height="18" />
                    </Button>
                    
                    <Button x:Name="BtnGlossaryCompact"
                            Width="28" Height="28" Padding="0" CornerRadius="3"
                            ToolTip.Tip="Glossary"
                            Classes="NavTabBtn"
                            Classes.active="{Binding ShowGlossary}">
                        <mi:MaterialIcon Kind="BookAlphabet" Width="18" Height="18" />
                    </Button>
                </StackPanel>

                <Button Grid.Row="1" x:Name="BtnToggleCompactExpand"
                        ToolTip.Tip="Expand Pane"
                        Width="28" Height="28" Padding="0" CornerRadius="3"
                        HorizontalAlignment="Center" Margin="0,0,0,8"
                        Classes="NavTabBtn">
                    <mi:MaterialIcon Kind="ChevronRight" Width="18" Height="18" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
