<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MMslcOverlay.ViewModels.Workspace"
        xmlns:views="clr-namespace:MMslcOverlay.Views.Workspace"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MMslcOverlay.Views.Workspace.WorkspaceWindow"
        x:DataType="vm:WorkspaceViewModel"
        Title="{Binding WorkspaceName}"
        Width="1000" Height="700"
        MinWidth="600" MinHeight="400"
        Topmost="False">
    <Grid RowDefinitions="Auto,*">
        <!-- MenuBar row -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Workspace"  Command="{Binding NewWorkspaceCommand}" />
                <MenuItem Header="_Open Workspace" Command="{Binding OpenWorkspaceCommand}" />
                <Separator />
                <MenuItem Header="_Export">
                    <MenuItem Header="SRT..."      Command="{Binding ExportSrtCommand}" />
                    <MenuItem Header="TXT..."      Command="{Binding ExportTxtCommand}" />
                    <MenuItem Header="Markdown..."  Command="{Binding ExportMdCommand}" />
                    <MenuItem Header="PDF..."      Command="{Binding ExportPdfCommand}" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- PaperSheet zone -->
        <ContentControl Grid.Row="1"
                        Content="{Binding Sheet}"
                        IsVisible="{Binding IsOpen}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:PaperSheetViewModel">
                    <views:PaperSheetView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

        <!-- Placeholder khi chưa có workspace -->
        <TextBlock Grid.Row="1"
                   Text="File > New Workspace để bắt đầu"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !IsOpen}" />
    </Grid>
</Window>
